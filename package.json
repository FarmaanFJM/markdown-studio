{
  "name": "markdown-studio",
  "productName": "Markdown Studio",
  "version": "0.1.0",
  "description": "A dedicated desktop editor for writing, previewing and exporting Markdown.",
  "author": "FarmaanFJM",
  "license": "MIT",
  "private": true,
  "main": "out/main/index.js",
  "homepage": "https://github.com/FarmaanFJM/markdown-studio",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run build && npm run test:e2e",
    "package:win": "npm run build && electron-builder --win --publish never",
    "package:linux": "npm run build && electron-builder --linux --publish never",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "notices": "node scripts/generate-notices.mjs",
    "screenshots": "npm run build && node scripts/capture-screenshots.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/css-tree": "2.3.11",
    "@types/katex": "0.16.8",
    "@types/markdown-it": "14.2.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "css-tree": "3.2.1",
    "dompurify": "3.4.17",
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "highlight.js": "11.12.0",
    "jsdom": "30.1.3",
    "katex": "0.19.1",
    "lucide-react": "1.61.0",
    "markdown-it": "15.0.3",
    "markdownlint": "0.41.1",
    "mermaid": "12.2.0",
    "monaco-editor": "0.57.0",
    "pdfjs-dist": "6.4.299",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "zustand": "5.0.16"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "$dompurify"
    }
  }
}
